# portal-partners — plantilla local
# cp .env.example .env
# Luego completa los valores reales en .env (ese archivo NO se sube a git)

# —— PostgreSQL ——
# Opcional (referencia). El servidor usa PGHOST/PG* abajo.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/portal_partners
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=portal_partners
PGUSER=postgres
PGPASSWORD=

# —— Cloudflare R2 (S3-compatible) ——
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
MAX_FILE_SIZE=524288000
ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,jpg,jpeg,png,gif,zip
VITE_MAX_FILE_SIZE=524288000

# —— Auth / sesión ——
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_TOKEN=portal-partners-local-admin

# —— Helpdesk (tickets + Gestión Partners Auditores) ——
# Base FastAPI con /api/v1 (local: http://localhost:8000/api/v1)
HELPDESK_API_URL=http://localhost:8000/api/v1
# Misma clave que N8N_INTEGRATION_API_KEY del backend helpdesk
HELPDESK_INTEGRATION_API_KEY=

# —— Email (Resend) ——
RESEND_API_KEY=
FROM_EMAIL=noreply@intercertlatam.com
PORTAL_PUBLIC_URL=http://localhost:5173
