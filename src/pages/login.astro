---
import '../index.css'
import { LOGO_URL } from '../constants'

if (Astro.cookies.get('auth_token')?.value) {
  return Astro.redirect('/dashboard')
}

let errorMessage = ''

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData()
  const email = String(formData.get('email') ?? '').trim()
  const password = String(formData.get('password') ?? '')

  // Demo SSR: cualquier credencial no vacía es válida
  if (email && password) {
    Astro.cookies.set('auth_token', 'token-demo-123', {
      path: '/',
      httpOnly: true,
      sameSite: 'lax',
      secure: import.meta.env.PROD,
    })

    return Astro.redirect('/dashboard')
  }

  errorMessage = 'Ingresa correo y contraseña para continuar.'
}
---

<!doctype html>
<html lang="es" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar sesión | Intercert Latam</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="flex min-h-full items-center justify-center bg-dashboard-surface p-6 font-sans text-on-surface antialiased"
  >
    <div
      class="w-full max-w-md rounded-xl border border-outline-variant/40 bg-surface-container-lowest p-8 shadow-level-1"
    >
      <div class="mb-8 flex justify-center">
        <img alt="Intercert" class="h-10 w-auto max-w-[240px] object-contain" src={LOGO_URL} />
      </div>
      <div class="mb-8 text-center">
        <h1 class="mb-2 text-headline-lg font-bold text-primary">Iniciar sesión</h1>
        <p class="text-body-md text-on-surface-variant">
          Accede al Partner Portal de Intercert Latam
        </p>
      </div>

      {
        errorMessage && (
          <p class="mb-4 rounded-lg bg-error-container px-3 py-2 text-body-md text-on-error-container">
            {errorMessage}
          </p>
        )
      }

      <form method="POST" class="space-y-5">
        <div>
          <label for="email" class="mb-2 block text-label-md font-semibold text-on-surface-variant">
            Correo electrónico
          </label>
          <input
            id="email"
            name="email"
            type="email"
            required
            placeholder="usuario@empresa.com"
            class="w-full rounded-lg border border-outline-variant bg-surface px-3 py-2.5 text-body-md outline-none transition-colors focus:border-secondary focus:ring-1 focus:ring-secondary"
          />
        </div>

        <div>
          <label
            for="password"
            class="mb-2 block text-label-md font-semibold text-on-surface-variant"
          >
            Contraseña
          </label>
          <input
            id="password"
            name="password"
            type="password"
            required
            placeholder="••••••••"
            class="w-full rounded-lg border border-outline-variant bg-surface px-3 py-2.5 text-body-md outline-none transition-colors focus:border-secondary focus:ring-1 focus:ring-secondary"
          />
        </div>

        <button
          type="submit"
          class="w-full rounded-lg bg-primary px-4 py-3 text-label-md font-semibold text-on-primary transition-colors hover:bg-primary/90"
        >
          Iniciar sesión
        </button>
      </form>

      <p class="mt-6 text-center text-body-md text-on-surface-variant">
        ¿No tienes cuenta?{' '}
        <a href="/registro" class="text-label-md font-semibold text-secondary hover:underline">
          Regístrate
        </a>
      </p>
    </div>
  </body>
</html>
