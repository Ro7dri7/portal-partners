---
import DashboardLayout from '../../layouts/DashboardLayout.astro'

const stats = [
  { label: 'Total Solicitudes', value: '124', icon: 'description', tint: 'bg-primary-container/5' },
  { label: 'En Revisión', value: '12', icon: 'sync', tint: 'bg-secondary/5' },
  { label: 'Aprobadas', value: '89', icon: 'check_circle', tint: 'bg-[#0a7a3b]/5' },
  { label: 'Pendientes', value: '23', icon: 'warning', tint: 'bg-[#c76f57]/5' },
]

const rows = [
  {
    id: 'REQ-2023-0891',
    type: 'ISO 9001:2015',
    icon: 'verified',
    date: '24 Oct 2023',
    status: 'Aprobado',
    tone: 'ok',
  },
  {
    id: 'REQ-2023-0904',
    type: 'ISO 14001:2015',
    icon: 'eco',
    date: '12 Nov 2023',
    status: 'En Revisión',
    tone: 'review',
  },
  {
    id: 'REQ-2023-0922',
    type: 'ISO 27001:2022',
    icon: 'security',
    date: '05 Dic 2023',
    status: 'Pendiente de Documentos',
    tone: 'pending',
  },
  {
    id: 'REQ-2023-0945',
    type: 'ISO 45001:2018',
    icon: 'health_and_safety',
    date: '15 Dic 2023',
    status: 'En Revisión',
    tone: 'review',
  },
  {
    id: 'REQ-2024-0012',
    type: 'ISO 9001:2015',
    icon: 'verified',
    date: '10 Ene 2024',
    status: 'Rechazado',
    tone: 'error',
  },
]

const badge: Record<string, string> = {
  ok: 'bg-[#E6F4EA] text-[#0D652D]',
  review: 'bg-[#E8F0FE] text-[#1967D2]',
  pending: 'bg-[#FEF7E0] text-[#B06000]',
  error: 'bg-[#FCE8E6] text-[#C5221F]',
}

const dot: Record<string, string> = {
  ok: 'bg-[#0D652D]',
  review: 'bg-[#1967D2]',
  pending: 'bg-[#B06000]',
  error: 'bg-[#C5221F]',
}
---

<DashboardLayout title="Estado de Solicitud">
  <div class="flex h-full min-h-0 w-full flex-col">
    <div class="mb-4 flex flex-col justify-between gap-3 md:flex-row md:items-center">
      <div>
        <h2 class="text-headline-md font-bold text-on-surface">Estado de Solicitudes</h2>
        <p class="mt-1 text-body-md text-on-surface-variant">
          Gestiona y monitorea el progreso de tus certificaciones.
        </p>
      </div>
      <div class="flex gap-3">
        <button
          type="button"
          class="flex items-center gap-2 rounded-lg border border-outline-variant bg-surface px-4 py-2 text-label-md font-semibold text-on-surface shadow-[0px_2px_4px_rgba(0,0,0,0.02)] transition-colors hover:bg-surface-container-low"
        >
          <span class="material-symbols-outlined text-[18px]">filter_list</span>
          Filtros
        </button>
        <button
          type="button"
          class="flex items-center gap-2 rounded-lg border border-outline-variant bg-surface px-4 py-2 text-label-md font-semibold text-on-surface shadow-[0px_2px_4px_rgba(0,0,0,0.02)] transition-colors hover:bg-surface-container-low"
        >
          <span class="material-symbols-outlined text-[18px]">download</span>
          Exportar
        </button>
      </div>
    </div>

    <div class="mb-4 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {
        stats.map((item) => (
          <div class="relative overflow-hidden rounded-lg border border-surface-container-high bg-surface p-3 shadow-[0px_2px_4px_rgba(0,0,0,0.05)]">
            <div class={`absolute -right-4 -top-4 h-16 w-16 rounded-bl-full ${item.tint}`} />
            <div class="mb-1 flex items-start justify-between">
              <h3 class="text-label-sm font-semibold text-on-surface-variant">{item.label}</h3>
              <span class="material-symbols-outlined text-[18px] text-outline">{item.icon}</span>
            </div>
            <p class="text-headline-md font-bold text-on-surface">{item.value}</p>
          </div>
        ))
      }
    </div>

    <div
      class="min-h-0 flex-1 overflow-hidden rounded-xl border border-surface-container-high bg-surface shadow-[0px_2px_4px_rgba(0,0,0,0.05)]"
    >
      <div class="overflow-x-auto">
        <table class="w-full border-collapse text-left">
          <thead>
            <tr class="border-b border-surface-container-high bg-surface-container-lowest">
              <th class="px-3 py-1.5 text-label-sm font-bold uppercase tracking-wider text-on-surface-variant"
                >ID de Solicitud</th
              >
              <th class="px-3 py-1.5 text-label-sm font-bold uppercase tracking-wider text-on-surface-variant"
                >Tipo de Certificación</th
              >
              <th class="px-3 py-1.5 text-label-sm font-bold uppercase tracking-wider text-on-surface-variant"
                >Fecha de Creación</th
              >
              <th class="px-3 py-1.5 text-label-sm font-bold uppercase tracking-wider text-on-surface-variant"
                >Estado</th
              >
              <th
                class="px-3 py-1.5 text-right text-label-sm font-bold uppercase tracking-wider text-on-surface-variant"
                >Acciones</th
              >
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-container-high text-on-surface">
            {
              rows.map((row) => (
                <tr class="transition-colors hover:bg-[#F5F7FA]">
                  <td class="whitespace-nowrap px-3 py-1.5 text-label-md font-semibold text-primary">
                    {row.id}
                  </td>
                  <td class="whitespace-nowrap px-3 py-1.5">
                    <div class="flex items-center gap-2">
                      <div class="flex h-7 w-7 items-center justify-center rounded bg-surface-container">
                        <span class="material-symbols-outlined text-[16px] text-outline">{row.icon}</span>
                      </div>
                      <span>{row.type}</span>
                    </div>
                  </td>
                  <td class="whitespace-nowrap px-3 py-1.5 text-on-surface-variant">{row.date}</td>
                  <td class="whitespace-nowrap px-3 py-1.5">
                    <span
                      class={`inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-[12px] font-semibold ${badge[row.tone]}`}
                    >
                      <span class={`h-1.5 w-1.5 rounded-full ${dot[row.tone]}`} />
                      {row.status}
                    </span>
                  </td>
                  <td class="whitespace-nowrap px-3 py-1.5 text-right">
                    <a
                      href={`/dashboard/estado/${row.id}`}
                      class="inline-flex items-center rounded-lg p-2 text-secondary transition-colors hover:bg-secondary/10"
                      title="Ver detalles"
                    >
                      <span class="material-symbols-outlined text-[20px]">visibility</span>
                    </a>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <div
        class="flex items-center justify-between border-t border-surface-container-high bg-surface px-3 py-1.5"
      >
        <span class="text-body-md text-on-surface-variant">Mostrando 1 - 5 de 124 resultados</span>
        <div class="flex gap-1">
          <button
            type="button"
            disabled
            class="flex h-8 w-8 items-center justify-center rounded border border-outline-variant text-on-surface-variant disabled:opacity-50"
          >
            <span class="material-symbols-outlined text-[18px]">chevron_left</span>
          </button>
          <button
            type="button"
            class="flex h-8 w-8 items-center justify-center rounded border border-secondary bg-secondary/10 text-label-md font-semibold text-secondary"
          >
            1
          </button>
          <button
            type="button"
            class="flex h-8 w-8 items-center justify-center rounded border border-outline-variant text-label-md text-on-surface-variant hover:bg-surface-container-low"
          >
            2
          </button>
          <button
            type="button"
            class="flex h-8 w-8 items-center justify-center rounded border border-outline-variant text-label-md text-on-surface-variant hover:bg-surface-container-low"
          >
            3
          </button>
          <span class="flex h-8 w-8 items-center justify-center text-on-surface-variant">...</span>
          <button
            type="button"
            class="flex h-8 w-8 items-center justify-center rounded border border-outline-variant text-on-surface-variant hover:bg-surface-container-low"
          >
            <span class="material-symbols-outlined text-[18px]">chevron_right</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</DashboardLayout>
